# =============================== #
# Aliases
# =============================== #

#list
alias ls='ls --color=auto'
alias la='ls -a'
alias ll='ls -la'
alias l='ls'

#fix obvious typo's
alias cd..='cd ..'

## Colorize the grep command output for ease of use (good for log files)##
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

#readable output
alias df='df -h'

#free
alias free="free -mt"

# Aliases for software managment
alias upal="sudo dnf upgrade"

# alias to use aliases also with sudo
alias sudo="sudo "

# git-bare repo for dotfiles
alias config="/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME"

# get oath code from yubikey
alias ykcode="ykman oath accounts code"

# clearaaa
alias clera="clear"

# neovim alias
alias nv="nvim"

# open vscode with ozone
alias code="env ELECTRON_OZONE_PLATFORM_HINT=auto code"

# =============================== #
# Functions
# =============================== #

# .gitignore file creator
function gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}

# NOTE: `tm` (tmux session picker) is NOT aliased here — on remotes the HM
# bashrc defines a guarded tm() FUNCTION (no-op inside tmux). An alias would
# be expanded while parsing that definition line and break it.

# =============================== #
# Ported from fish config (nixos-config home/programs/fish.nix)
# =============================== #

# zed's binary is called zeditor in nixpkgs
alias zed="zeditor"

# Lazygit
alias lg="lazygit"

# NixOS system management (only usable on NixOS hosts; harmless elsewhere)
alias rebuild="sudo nixos-rebuild switch --flake ~/nixos-config#nixos"
# NOTE: fish's `update` (nix flake update + rebuild) is intentionally NOT
# ported — bash keeps `update` = dnf upgrade for the Fedora laptop.

# Activate Python virtualenv (bash port of the fish function)
function venv() {
    if [ -f .venv/bin/activate ]; then
        source .venv/bin/activate
    elif [ -f "$HOME/.venv/bin/activate" ]; then
        source "$HOME/.venv/bin/activate"
    else
        echo "No virtualenv found"
    fi
}

